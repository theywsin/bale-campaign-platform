{
  "name": "@bcp/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=../../.env --watch-path=dist dist/main.js)",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "admin:create": "node --env-file-if-exists=../../.env dist/cli/create-admin.js"
  },
  "dependencies": {
    "@bcp/config": "0.1.0",
    "@bcp/database": "0.1.0",
    "@bcp/shared": "0.1.0",
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "argon2": "0.45.1",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.2.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/nodemailer": "7.0.12",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$"
      },
      {
        "displayName": "integration",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "rootDir": "test",
        "testRegex": ".*\\.int\\.ts$",
        "globalSetup": "<rootDir>/global-setup.ts",
        "testTimeout": 30000
      }
    ]
  }
}
