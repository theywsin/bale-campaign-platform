# =============================================================================
# Bale Campaign Platform — environment variables
# Copy to `.env` and fill in. Never commit `.env`.
# Generate secrets with:  openssl rand -base64 36 | tr -d '/+=' 
# =============================================================================

# ---- shared -------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
APP_VERSION=0.1.0

# ---- docker compose (production-like stack) -------------------------------------
POSTGRES_USER=bcp
POSTGRES_DB=bcp
# REQUIRED for docker compose. Long random value, no '@', ':' or '/'.
POSTGRES_PASSWORD=
# REQUIRED for docker compose. Long random value.
REDIS_PASSWORD=
# Nginx listens on these host addresses/ports. Keep 127.0.0.1 unless the host
# firewall and TLS (NGINX_SITE=https) are configured.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
HTTPS_BIND=127.0.0.1
HTTPS_PORT=8443
# local = plain HTTP (local/staging), https = TLS with certs from TLS_CERT_DIR
NGINX_SITE=local
TLS_CERT_DIR=./infra/nginx/certs

# ---- connection strings (local development with docker-compose.dev.yml) --------
# docker compose builds these itself from POSTGRES_* / REDIS_PASSWORD.
DATABASE_URL=postgresql://bcp:bcp_dev_only@127.0.0.1:5432/bcp?schema=public
DATABASE_POOL_MAX=10
REDIS_URL=redis://127.0.0.1:6379/0

# ---- api -----------------------------------------------------------------------
API_PORT=4000
# Public URL of the web panel (scheme + host). Used for links in e-mails and as allowed origin.
APP_URL=http://localhost:3000
# Extra allowed origins, comma separated.
CORS_ORIGINS=
# Number of reverse proxies in front of the API (1 behind the bundled nginx).
TRUST_PROXY_HOPS=0
# Must be true in production (HTTPS). Set false only for local plain-HTTP development.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
SESSION_IDLE_TIMEOUT_HOURS=48
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_PER_MINUTE=300
SWAGGER_ENABLED=true
# Leave empty to disable e-mail (password reset / verification mails are then not sent).
# Example: smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM="Bale Campaign <no-reply@example.com>"

# Test-only mock messaging provider (no real messages are sent). Keep false in production.
MESSAGING_MOCK_ENABLED=true

# Encrypts Bale bot tokens (AES-256-GCM). base64 of 32 random bytes: openssl rand -base64 32
# Kept outside the database; losing it makes stored bot tokens unusable (re-enter them).
CREDENTIALS_ENCRYPTION_KEY=
# Bale Bot API. Change only for tests (tests/fake-bale/server.mjs); production requires https.
BALE_API_BASE_URL=https://tapi.bale.ai

# ---- web (dev only; in docker the value is baked at build time) ----------------
API_INTERNAL_URL=http://localhost:4000

# ---- worker / scheduler --------------------------------------------------------
WORKER_HEALTH_PORT=4100
WORKER_CONCURRENCY=5
SCHEDULER_HEALTH_PORT=4200
