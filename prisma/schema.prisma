// Bale Campaign Platform — Prisma schema
// Conventions: UUID primary keys, timestamptz columns (stored in UTC),
// snake_case table/column names via @@map/@map.

generator client {
  provider     = "prisma-client"
  output       = "../packages/database/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// System
// ---------------------------------------------------------------------------

model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(500)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@map("system_settings")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum PlatformRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
  BILLING_ADMIN
  MODERATOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum UserTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id                String        @id @default(uuid(7)) @db.Uuid
  /// Always stored lower-cased and trimmed (see emailSchema in @bcp/shared).
  email             String        @unique @db.VarChar(254)
  /// Argon2id hash (PHC string). The plain password is never stored.
  passwordHash      String        @map("password_hash") @db.VarChar(255)
  fullName          String        @map("full_name") @db.VarChar(100)
  status            UserStatus    @default(ACTIVE)
  /// Staff role on the operator side; null for customers.
  platformRole      PlatformRole? @map("platform_role")
  emailVerifiedAt   DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  passwordChangedAt DateTime      @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt       DateTime?     @map("last_login_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions            Session[]
  tokens              UserToken[]
  memberships         OrganizationMember[]
  invitationsSent     Invitation[]         @relation("InvitationInviter")
  organizationsCreated Organization[]      @relation("OrganizationCreator")

  @@index([createdAt])
  @@index([platformRole])
  @@map("users")
}

/// Server-side web session. The cookie carries a random token; only its SHA-256 is stored.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use tokens sent by e-mail (verification, password reset). Only the hash is stored.
model UserToken {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   UserTokenPurpose
  tokenHash String           @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("user_tokens")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationRole {
  ORGANIZATION_OWNER
  ORGANIZATION_ADMIN
  ORGANIZATION_MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

/// A tenant. Every customer-owned row references an organization.
model Organization {
  id          String             @id @default(uuid(7)) @db.Uuid
  name        String             @db.VarChar(100)
  slug        String             @unique @db.VarChar(64)
  status      OrganizationStatus @default(ACTIVE)
  createdById String?            @map("created_by_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt  DateTime?          @map("archived_at") @db.Timestamptz(3)

  createdBy   User?                @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members     OrganizationMember[]
  invitations Invitation[]
  auditLogs   AuditLog[]

  @@index([status, createdAt])
  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

/// At most one PENDING invitation per (organization, email): enforced by a partial unique index in SQL.
model Invitation {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String           @db.VarChar(254)
  role           OrganizationRole
  tokenHash      String           @unique @map("token_hash") @db.Char(64)
  status         InvitationStatus @default(PENDING)
  invitedById    String?          @map("invited_by_id") @db.Uuid
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([email, status])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

enum AuditCategory {
  SECURITY
  ORGANIZATION
  ADMIN
  BILLING
  CAMPAIGN
}

/// Append-only record of sensitive actions. Never store secrets in `metadata`.
model AuditLog {
  id             String        @id @default(uuid(7)) @db.Uuid
  category       AuditCategory
  action         String        @db.VarChar(100)
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  targetType     String?       @map("target_type") @db.VarChar(50)
  targetId       String?       @map("target_id") @db.VarChar(100)
  ipAddress      String?       @map("ip_address") @db.VarChar(45)
  userAgent      String?       @map("user_agent") @db.VarChar(500)
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
  @@index([action])
  @@map("audit_logs")
}
